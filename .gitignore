node_modules/
dist/
build/
coverage/
# Tous les fichiers .env reels (audit securite OWASP #262 - .env, .env.local,
# .env.production...), sauf le gabarit versionne intentionnellement.
.env*
!.env.example
*.log
.DS_Store

# Données volumineuses du moteur de routage (export GTFS, extrait OSM, graphe compilé)
routing-engine/data/*
!routing-engine/data/.gitkeep

# Outillage local de Claude Code et des skills (specifique a la machine /
# a la session, aucun interet dans le depot - et .claude/settings.local.json
# porterait des regles de permission avec des adresses d'infrastructure).
.claude/
skills-lock.json
superpowers/
.impeccable/

# Documents d'enonce fournis par l'ecole (sujet, grille, guide de soutenance) :
# depot public, on ne redistribue pas ces PDF. Le dossier rendu en juillet
# (UrbanFlow_Mobility_Dossier.md) reste versionne comme reference.
docs/documents_juillet/*.pdf