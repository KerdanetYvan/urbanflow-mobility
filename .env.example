# Copier ce fichier vers .env et compléter les valeurs avant de lancer docker compose

# --- Base de données ---
POSTGRES_DB=urbanflow
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://urbanflow:changeme@postgres:5432/urbanflow
# Le schema est gere par les migrations TypeORM (backend/src/migrations/,
# lancees automatiquement au demarrage du conteneur backend). Garde-fou
# manuel uniquement - ne pas passer a "true" en usage normal.
TYPEORM_SYNC=false

# --- Authentification (JWT + refresh tokens, partie 3.10 du dossier) ---
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- CORS (origine autorisee a appeler l'API depuis un navigateur) ---
CORS_ORIGIN=http://localhost:5173

# --- Moteur de routage ---
OTP_URL=http://otp:8080/otp/routers/default
# Fuseau horaire de l'agence GTFS chargee dans OTP (voir agency_timezone du
# flux GTFS) : necessaire pour formater date/heure de depart correctement
# quel que soit le fuseau du serveur (conteneur Docker en UTC par defaut).
OTP_TIMEZONE=Europe/Paris

# --- Services tiers (service de scoring, partie 7.3 du dossier) ---
WEATHER_API_KEY=
WEATHER_API_URL=

# --- Email (reinitialisation de mot de passe, issue #70) ---
# Auto-heberge plutot qu'un SaaS externe (Resend, SendGrid...) pour ne pas
# dependre d'un quota d'envoi tiers - voir backend/README.md. MailHog en dev
# (docker-compose.yml, capture les emails sans les envoyer, consultable sur
# http://localhost:8025) ; Postfix en prod (docker-compose.prod.yml).
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=no-reply@urbanflow-mobility.local
# Vides en dev : MailHog n'exige pas d'authentification.
MAIL_USER=
MAIL_PASSWORD=
RESET_TOKEN_EXPIRATION_MINUTES=60
# Prod uniquement (service postfix, docker-compose.prod.yml) : domaine(s)
# autorises a emettre via ce relai (voir le commentaire du service postfix).
MAIL_ALLOWED_SENDER_DOMAINS=urbanflow-mobility.kerdanetyvan.dev

# --- Frontend ---
VITE_API_URL=http://localhost:3000
# URL publique du frontend, utilisee par le backend pour construire le lien
# de reinitialisation envoye par email (issue #70).
FRONTEND_URL=http://localhost:5173
