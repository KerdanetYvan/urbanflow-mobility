# Copier ce fichier vers .env et compléter les valeurs avant de lancer docker compose

# --- Base de données ---
POSTGRES_DB=urbanflow
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://urbanflow:changeme@postgres:5432/urbanflow
# Le schema est gere par les migrations TypeORM (backend/src/migrations/,
# lancees automatiquement au demarrage du conteneur backend). Garde-fou
# manuel uniquement - ne pas passer a "true" en usage normal.
TYPEORM_SYNC=false

# --- Authentification (JWT + refresh tokens, partie 3.10 du dossier) ---
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- CORS (origine autorisee a appeler l'API depuis un navigateur) ---
CORS_ORIGIN=http://localhost:5173

# --- Moteur de routage ---
OTP_URL=http://otp:8080/otp/routers/default
# Fuseau horaire de l'agence GTFS chargee dans OTP (voir agency_timezone du
# flux GTFS) : necessaire pour formater date/heure de depart correctement
# quel que soit le fuseau du serveur (conteneur Docker en UTC par defaut).
OTP_TIMEZONE=Europe/Paris

# --- Geocodage d'adresses (Nominatim auto-heberge, issue #167/#168) ---
# URL interne du service nominatim (reseau Docker) - le backend l'appelle
# pour les suggestions d'adresses, en complement du geocodeur OTP qui ne
# connait que les arrets. Voir docs/specs/nominatim-geocodage-adresses.md.
NOMINATIM_URL=http://nominatim:8080
# Mot de passe de la base PostgreSQL interne de Nominatim (service isole,
# jamais les donnees metier). Valeur libre en dev.
NOMINATIM_DB_PASSWORD=changeme

# --- Ingestion GTFS statique (F3, issue #12) ---
# Flux open data reel de Rennes Metropole (reseau STAR), republie chaque
# nuit - voir backend/README.md pour l'usage de `npm run import:gtfs`.
GTFS_SOURCE_URL=https://eu.ftp.opendatasoft.com/star/gtfs/GTFS_STAR_BUS_METRO_EN_COURS.zip
# Si renseigne, lit ce fichier local au lieu de telecharger GTFS_SOURCE_URL
# (utile en dev/CI hors ligne, ex. routing-engine/test-fixtures/gtfs-test.zip).
GTFS_LOCAL_PATH=
# Chemin (dans le conteneur backend) ou le zip valide est ecrit pour etre
# repris par OpenTripPlanner au prochain `docker compose up --build` -
# correspond au volume routing-engine/data monte a cet endroit (voir
# docker-compose.yml, service backend).
GTFS_OTP_OUTPUT_PATH=/app/routing-engine/data/gtfs-metropole.zip

# --- Operateurs de mobilite partagee (GBFS + GTFS-Realtime, F3, issue #15) ---
# Architecture pluggable : un operateur s'integre par simple ajout d'une
# entree a ce tableau JSON, sans modification de code (OperatorsService,
# consomme par GbfsCacheService #13 et GtfsRealtimeCacheService #14 - voir
# backend/README.md section "Architecture pluggable pour un nouvel
# operateur"). Chaque entree : { id, name, gbfsDiscoveryUrl?,
# gtfsRealtimeTripUpdatesUrl?, gtfsRealtimeAlertsUrl? } - seuls id/name sont
# obligatoires, un operateur peut ne publier qu'une partie de ces flux.
#
# Absent (valeur vide, comme ci-dessous) = repli sur l'operateur par defaut
# code en dur dans OperatorsService (flux reels "le velo STAR" + GTFS-RT de
# Rennes Metropole, verifies en session) - suffisant pour le developpement
# courant, aucune valeur a renseigner ici en usage normal a un seul
# operateur.
#
# Exemple a DEUX operateurs (a adapter, ne pas decommenter tel quel) :
# MOBILITY_OPERATORS=[{"id":"star-rennes","name":"STAR (Rennes Métropole)","gbfsDiscoveryUrl":"https://eu.ftp.opendatasoft.com/star/gbfs/gbfs.json","gtfsRealtimeTripUpdatesUrl":"https://proxy.transport.data.gouv.fr/resource/star-rennes-integration-gtfs-rt-trip-update","gtfsRealtimeAlertsUrl":"https://proxy.transport.data.gouv.fr/resource/star-rennes-integration-gtfs-rt-alerts"},{"id":"nouvel-operateur","name":"Nouvel opérateur","gbfsDiscoveryUrl":"https://nouvel-operateur.example/gbfs.json"}]
MOBILITY_OPERATORS=

# --- Suivi de trajet et notifications push (F3, issue #18) ---
# Cles VAPID (protocole Web Push) - generer une paire dediee au projet avec
# `npx web-push generate-vapid-keys` (backend/) ; NE JAMAIS committer de
# vraies valeurs ici. Notifications desactivees (degradation, pas de crash)
# tant que les trois variables ne sont pas renseignees - voir
# PushNotificationService.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact de l'exploitant du service push (spec Web Push, requis par
# web-push) - une URL https: ou une adresse mailto:.
VAPID_SUBJECT=mailto:contact@urbanflow-mobility.example

# --- Service meteo (critere de scoring, partie 7.3 du dossier, issue #17) ---
# Open-Meteo (api.open-meteo.com) retenu : pas de cle API a provisionner
# (contrairement a la plupart des fournisseurs), hebergement UE, gratuit en
# usage non-commercial - voir WeatherService. Absent = valeur par defaut
# codee en dur (URL publique d'Open-Meteo) ; a ne renseigner que pour
# pointer vers une autre instance (tests, self-host).
WEATHER_API_URL=

# --- Email (reinitialisation de mot de passe, issue #70) ---
# Auto-heberge plutot qu'un SaaS externe (Resend, SendGrid...) pour ne pas
# dependre d'un quota d'envoi tiers - voir backend/README.md. MailHog en dev
# (docker-compose.yml, capture les emails sans les envoyer, consultable sur
# http://localhost:8025) ; Postfix en prod (docker-compose.prod.yml).
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=no-reply@urbanflow-mobility.local
# Vides en dev : MailHog n'exige pas d'authentification.
MAIL_USER=
MAIL_PASSWORD=
RESET_TOKEN_EXPIRATION_MINUTES=60
# Prod uniquement (service postfix, docker-compose.prod.yml) : domaine(s)
# autorises a emettre via ce relai (voir le commentaire du service postfix).
MAIL_ALLOWED_SENDER_DOMAINS=urbanflow-mobility.kerdanetyvan.dev

# --- Chiffrement au repos des donnees de geolocalisation (RGPD, issue #22) ---
# Requise uniquement des qu'une colonne utilise createEncryptedColumnTransformer
# (backend/src/common/encryption/, voir docs/specs/rgpd-geolocalisation.md) -
# aucune colonne ne l'utilise encore a ce jour (#11/#113 pas encore faits).
# Base64 de 32 octets exactement (AES-256) - generer avec `openssl rand -base64 32`.
GEOLOCATION_ENCRYPTION_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:3000
# URL publique du frontend, utilisee par le backend pour construire le lien
# de reinitialisation envoye par email (issue #70).
FRONTEND_URL=http://localhost:5173
