<?xml version='1.0' encoding='UTF-8'?>
<!--
  Extrait OpenStreetMap synthetique minimal pour le developpement local
  (issue #40) - une seule rue en boucle qui passe par les 4 arrets du GTFS
  de test (gtfs-test.zip), pour qu'OpenTripPlanner puisse construire un
  graphe pietons/velos/voitures et calculer des itineraires de bout en bout
  sans dependre du vrai export OSM de la metropole.

  Coordonnees purement fictives (aucune rue reelle) : 8 noeuds formant une
  boucle fermee, les 4 sommets "pairs" coincidant avec les 4 arrets de bus
  (A, B, C, D), les 4 "impairs" servant de points intermediaires pour une
  forme moins anguleuse. Environ 1,3-1,5 km entre deux arrets adjacents -
  volontairement pas trop proches, sinon OpenTripPlanner considere la
  marche "triviale" et ne propose jamais le bus (verifie en pratique lors
  de la construction de ce fixture, cf. commit history).
-->
<osm version="0.6" generator="urbanflow-mobility-seed">
  <bounds minlat="45.7300" minlon="4.8300" maxlat="45.7720" maxlon="4.8500"/>

  <!-- Noeud proche de l'arret A (Place Centrale) -->
  <node id="1001" lat="45.7540" lon="4.8400" version="1"/>
  <!-- Point intermediaire A -> B -->
  <node id="1002" lat="45.7580" lon="4.8440" version="1"/>
  <!-- Noeud proche de l'arret B (Gare Test) -->
  <node id="1003" lat="45.7620" lon="4.8480" version="1"/>
  <!-- Point intermediaire B -> C -->
  <node id="1004" lat="45.7660" lon="4.8440" version="1"/>
  <!-- Noeud proche de l'arret C (Universite) -->
  <node id="1005" lat="45.7700" lon="4.8400" version="1"/>
  <!-- Point intermediaire C -> D -->
  <node id="1006" lat="45.7660" lon="4.8360" version="1"/>
  <!-- Noeud proche de l'arret D (Hopital) -->
  <node id="1007" lat="45.7620" lon="4.8320" version="1"/>
  <!-- Point intermediaire D -> A -->
  <node id="1008" lat="45.7580" lon="4.8360" version="1"/>

  <way id="2001" version="1">
    <nd ref="1001"/>
    <nd ref="1002"/>
    <nd ref="1003"/>
    <nd ref="1004"/>
    <nd ref="1005"/>
    <nd ref="1006"/>
    <nd ref="1007"/>
    <nd ref="1008"/>
    <nd ref="1001"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Rue de la Boucle Test"/>
    <tag k="maxspeed" v="30"/>
  </way>
</osm>
